+void CheckImportedIndices(Fixture& fixture) {
+    constexpr std::size_t blockBytes = 2u << 20u;
+    auto* block = AllocateWatched(blockBytes, 65536);
+    Require(block != nullptr, "write-watched index block unavailable");
+    GuestAllocations::Mutation().Add(block, blockBytes, true, true, true);
+    struct Release {
+        void* memory;
+        ~Release() {
+            GuestAllocations::Mutation().Remove(memory);
+            ReleaseWatched(memory, blockBytes);
+        }
+    } release{block};
+    const auto address = reinterpret_cast<std::uintptr_t>(block);
+    const auto vertex = fixture.Vertex(RuntimeFetchCode, fixture.UserData(0, 0), true);
+    Require(vertex.vertexAttributes.empty(), "the fixture must use shader vertex pulling");
+    VertexSlots.fill(0);
+    InstanceSlots.fill(0);
+    const unsigned count = static_cast<unsigned>(std::stoul(std::getenv("VERIFY_INDEX_COUNT")));
+    const bool allRestart = std::string(std::getenv("VERIFY_INDEX_MODE")) == "all-restart";
+    const std::vector<std::uint16_t> indices(count, allRestart ? 0xffffu : 9u);
+    AgcDriver::GuestMemory::Write(address, std::as_bytes(std::span{indices}));
+    for (unsigned batch=0; batch<11; ++batch) {
+        const AgcDriver::Pm4::DrawParameters draw{address, count, 2, 1, 0, true, 0, 0};
+        fixture.Draw(vertex, draw, allRestart);
+        if (allRestart) Require(std::ranges::all_of(Output, [](auto w){return w==Unwritten;}), "all-restart draw wrote output");
+        else Require(Output[0]==9 && Output[1]==0 && Output[2]==9 && Output[3]==0, "ordinary draw lost its output");
+    }
+}
